{
  "name": "napcat-plugin-group-manager",
  "plugin": "群管助手",
  "version": "0.1.0",
  "description": "NapCat 群管理插件合集：手动禁言/踢人/解禁/撤回、随机禁言、黑历史、新人禁言、静默成员检查、加群审核、撤回统计。支持一条配置绑定多个群，WebUI 可视化配置。",
  "author": "Dmocken",
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "build": "node scripts/preflight.mjs && vite build && vite build -c vite.webui.config.ts && node scripts/pack.mjs",
    "deploy": "node scripts/preflight.mjs && vite build && vite build -c vite.webui.config.ts && node scripts/pack.mjs --deploy",
    "build:plugin": "vite build",
    "build:webui": "vite build -c vite.webui.config.ts",
    "pack": "node scripts/pack.mjs",
    "dev:webui": "vite -c vite.webui.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webui.json --noEmit"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^11.1.21",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "zustand": "^5.0.15"
  },
  "napcat": {
    "tags": [
      "群管",
      "工具"
    ],
    "minVersion": "4.14.0",
    "homepage": ""
  }
}
